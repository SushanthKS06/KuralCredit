# ---------------------------------------------------------------------------
# KuralCredit configuration reference. Copy to .env and fill real values.
# Never commit .env. All values here are placeholders.
# ---------------------------------------------------------------------------

APP_ENV=development
# real = call Gnani/Groq. mock = explicit deterministic demo (never in production).
PROVIDER_MODE=real
APP_NAME=KuralCredit
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./kuralcredit.db

# Gnani Speech APIs (single key for Prisma STT + Timbre TTS)
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_ENABLED=true
GNANI_TTS_ENABLED=true
GNANI_STT_TIMEOUT_SECONDS=45
GNANI_TTS_TIMEOUT_SECONDS=45
GNANI_MAX_RETRIES=2
GNANI_DEFAULT_LANGUAGE=ta-IN
GNANI_DEFAULT_VOICE=Trisha
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=transcribe
GNANI_CAPABILITY_CATALOG_PATH=backend/app/config/capabilities.json

# Groq reasoning
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_MAX_INPUT_CHARS=12000
GROQ_STRICT_SCHEMA=true

# Uploads, retention and safety
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_AUDIO_UPLOAD_SIZE_MB=15
ALLOWED_DOCUMENT_TYPES=pdf,csv,xlsx
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_HOURS=24
DOCUMENT_RETENTION_DAYS=30
LOG_LEVEL=INFO
LOG_REDACT_PII=true
RATE_LIMIT_PER_MINUTE=30
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo-only reviewer credentials. Unset in production deployments.
REVIEWER_DEMO_EMAIL=reviewer@kuralcredit.demo
REVIEWER_DEMO_PASSWORD=test-reviewer-password
REVIEWER_DISPLAY_NAME=Demo Reviewer

# Session lifetime
SESSION_TTL_HOURS=12

# Comparison policy (demo rule; visible to reviewers)
RECONCILIATION_TOLERANCE_PERCENT=5





